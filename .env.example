############################
# MovieMind environment vars
############################

# ---- MySQL ----
# Change these later (local)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_NAME=movieMind

# Optional single URL (alternative to the 4 vars above)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/movieMind

# ---- OpenAI ----
# IMPORTANT: put your real key in `.env` (not committed). Rotate the key you pasted in chat.
OPENAI_API_KEY=sk-your-key-here

# ---- FastAPI base URL (optional) ----
MOVIEMIND_API_BASE_URL=http://127.0.0.1:8000

